From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zkjh team <dev@example.com>
Date: 2026-11-09 15:24:00 +0800
Subject: [PATCH] T23ZN clock hardening and JKD-621 I2C/TF bring-up

- guard the absent T23ZN SSI CGU on rate/parent/init paths
- skip SSI0 gate and reparent it to EXT1
- bound CGU busy waits and remove temporary boot probes
- select I2C0 PA12/PA13, disable conflicting I2C1 PA16/PA17
- build VFAT into the kernel for the minimal rootfs
- synchronize the rescue initrd size
---
--- a/arch/mips/configs/zeratul_SOC_T23_NOR_camera_IIC_V1_defconfig
+++ b/arch/mips/configs/zeratul_SOC_T23_NOR_camera_IIC_V1_defconfig
@@ -1013,15 +1013,14 @@
 # CONFIG_I2C_DEBUG_INFO is not set
 # CONFIG_SOFT_I2C0_GPIO_V12_JZ is not set
 CONFIG_I2C0_V12_JZ=y
-# CONFIG_I2C0_PA12_PA13 is not set
-CONFIG_I2C0_BOOT_DEFAULT=y
+CONFIG_I2C0_PA12_PA13=y
+# CONFIG_I2C0_BOOT_DEFAULT is not set
 # CONFIG_I2C0_NON_RESTART_MODE is not set
 CONFIG_I2C0_SPEED=100
 # CONFIG_SOFT_I2C1_GPIO_V12_JZ is not set
-CONFIG_I2C1_V12_JZ=y
+# CONFIG_I2C1_V12_JZ is not set
 # CONFIG_I2C1_PB25_PB26 is not set
-CONFIG_I2C1_PA16_PA17=y
-CONFIG_I2C1_SPEED=100
+# CONFIG_I2C1_PA16_PA17 is not set
 # CONFIG_I2C1_NON_RESTART_MODE is not set
 # CONFIG_SOFT_I2C2_GPIO_V12_JZ is not set
 # CONFIG_I2C2_V12_JZ is not set
@@ -1771,9 +1770,9 @@
 #
 # DOS/FAT/NT Filesystems
 #
-CONFIG_FAT_FS=m
+CONFIG_FAT_FS=y
 # CONFIG_MSDOS_FS is not set
-CONFIG_VFAT_FS=m
+CONFIG_VFAT_FS=y
 CONFIG_FAT_DEFAULT_CODEPAGE=437
 CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
 # CONFIG_EXFAT_FS is not set
@@ -2000,7 +1999,8 @@
 # CONFIG_TEST_STRING_HELPERS is not set
 # CONFIG_TEST_KSTRTOX is not set
 # CONFIG_EARLY_PRINTK is not set
-# CONFIG_CMDLINE_BOOL is not set
+CONFIG_CMDLINE="console=ttyS1,115200n8 root=/dev/ram0 rw rdinit=/linuxrc"
+CONFIG_CMDLINE_FORCE=y
 # CONFIG_DEBUG_STACKOVERFLOW is not set
 # CONFIG_RUNTIME_DEBUG is not set
 # CONFIG_DEBUG_ZBOOT is not set
--- a/arch/mips/xburst/core/prom.c
+++ b/arch/mips/xburst/core/prom.c
@@ -48,6 +48,11 @@
 extern struct plat_smp_ops jzsoc_smp_ops;
 void __init prom_init(void)
 {
+	extern unsigned long initrd_start, initrd_end;
+	/* U-Boot rescue path loads the raw cpio to 0x81600000.  Keep this size
+	 * synchronized with mvp/releases/rootfs-ask.cpio (currently 0x493c00). */
+	initrd_start = 0x81600000UL;
+	initrd_end = initrd_start + 0x493c00UL;
 	prom_init_cmdline((int)fw_arg0, (char **)fw_arg1);
 
 	mips_machtype = MACH_XBURST;
--- a/arch/mips/xburst/soc-t23/common/clk/clk.c
+++ b/arch/mips/xburst/soc-t23/common/clk/clk.c
@@ -91,26 +91,27 @@
 	int i;
 	struct clk *clk_srcs = get_clk_from_id(0);
 	int clk_srcs_size = get_clk_sources_size();
