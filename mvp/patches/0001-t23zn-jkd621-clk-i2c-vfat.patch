 	for(i = 0; i < clk_srcs_size; i++) {
 		clk_srcs[i].CLK_ID = i;
-		if(clk_srcs[i].flags & CLK_FLG_CPCCR) {
+		/* T23ZN has no SSI CGU. Skip the SSI0 gate so clock-tree init
+		 * cannot reach its absent parent through gate operations. */
+		if(i == CLK_ID_SSI0)
+			continue;
+		if(clk_srcs[i].flags & CLK_FLG_CPCCR)
 			init_cpccr_clk(&clk_srcs[i]);
-		}
-		if(clk_srcs[i].flags & CLK_FLG_CGU) {
+		if(clk_srcs[i].flags & CLK_FLG_CGU)
 			init_cgu_clk(&clk_srcs[i]);
-		}
-		if(clk_srcs[i].flags & CLK_FLG_PLL) {
+		if(clk_srcs[i].flags & CLK_FLG_PLL)
 			init_ext_pll(&clk_srcs[i]);
-		}
-		if(clk_srcs[i].flags & CLK_FLG_NOALLOC) {
+		if(clk_srcs[i].flags & CLK_FLG_NOALLOC)
 			init_ext_pll(&clk_srcs[i]);
-		}
-		if(clk_srcs[i].flags & CLK_FLG_GATE) {
+		if(clk_srcs[i].flags & CLK_FLG_GATE)
 			init_gate_clk(&clk_srcs[i]);
-		}
 		if(clk_srcs[i].flags & CLK_FLG_ENABLE)
 			clk_srcs[i].init_state = 1;
 	}
+
 	for(i = 0; i < clk_srcs_size; i++) {
 		if(clk_srcs[i].parent && clk_srcs[i].init_state)
 			init_clk_parent(clk_srcs[i].parent);
@@ -125,6 +126,7 @@
 			clk_srcs[CLK_ID_H2CLK].rate/1000/1000,
 			clk_srcs[CLK_ID_PCLK].rate/1000/1000);
 }
+
 struct clk *clk_get(struct device *dev, const char *id)
 {
 	int i;
--- a/arch/mips/xburst/soc-t23/common/clk/clk_cgu.c
+++ b/arch/mips/xburst/soc-t23/common/clk/clk_cgu.c
@@ -9,6 +9,26 @@
 #include <soc/extal.h>
 #include <soc/ddr.h>
 #include "clk.h"
+
+/* T23ZN-DEFENSE: SSI CGU is absent on this silicon. Guard every rate,
+ * parent and init path so no code path can touch CPM_SSICDR. */
+#define CGU_BUSY_TIMEOUT 10000000
+static int t23zn_absent_cgu(int no)
+{
+	return no == CGU_SSI;
+}
+
+static void cgu_wait_busy(unsigned int off, unsigned int busy)
+{
+	int timeout = CGU_BUSY_TIMEOUT;
+	while(cpm_test_bit(busy, off)) {
+		if(--timeout <= 0) {
+			printk("CGU busy timeout: off=0x%08x busy=%u\n", off, busy);
+			break;
+		}
+	}
+}
+
 static DEFINE_SPINLOCK(cpm_cgu_lock);
 struct clk_selectors {
 	unsigned int route[4];
@@ -114,6 +134,7 @@
 	unsigned long x;
 	unsigned long flags;
 	int no = CLK_CGU_NO(clk->flags);
+	if(t23zn_absent_cgu(no)) return 0; /*T23ZN-DEFENSE*/
 
 	if (!(strcmp(clk->name, "cgu_i2s_spk")) || !(strcmp(clk->name, "cgu_i2s_mic"))) {
 		unsigned int reg_val = 0;
@@ -178,9 +199,7 @@
 			unsigned int x = cgu_clks[no].cache;
 			x = (x & ~(0x1 << stop)) | (0x1 << ce);
 			cpm_outl(x,cgu_clks[no].off);
-			while(cpm_test_bit(busy,cgu_clks[no].off)) {
-				printk("wait stable.[%d][%s]\n",__LINE__,clk->name);
-			}
+			cgu_wait_busy(cgu_clks[no].off, busy);
 			cpm_clear_bit(ce, cgu_clks[no].off);
 			x &= (1 << cgu_clks[no].div) - 1;
 			x = (x + 1) * cgu_clks[no].coe;
@@ -284,8 +303,7 @@
 	} else if((mask & reg_val) != i) {
 		x = (x & ~(0x1 << stop)) | (0x1 << ce);
 		cpm_outl(x, cgu_clks[no].off);
-		while(cpm_test_bit(busy,cgu_clks[no].off))
-			printk("wait stable.[%d][%s]\n",__LINE__,clk->name);
+		cgu_wait_busy(cgu_clks[no].off, busy);
 		x &= ~(1 << ce);
 		cpm_outl(x, cgu_clks[no].off);
 		cgu_clks[no].cache = 0;
@@ -303,6 +321,7 @@
 	unsigned int no,cgu,idx,pidx;
 
 	no = CLK_CGU_NO(clk->flags);
+	if(t23zn_absent_cgu(no)) return NULL; /*T23ZN-DEFENSE*/
 	if(!(strcmp(clk->name, "cgu_i2s_mic"))){
 		/* the operation uses for t31, because that the bits[30~31] of 0x10000084 is readonly */
 		cgu = *(volatile unsigned int*)(0xb0000070); // the register is i2s speaker pll.
@@ -364,8 +383,7 @@
 		cgu_clks[no].cache = cgu;
 	else if((mask & reg_val) != i){
 		cpm_outl(cgu, cgu_clks[no].off);
-		while(cpm_test_bit(busy,cgu_clks[no].off))
-			printk("wait stable.[%d][%s]\n",__LINE__,clk->name);
+		cgu_wait_busy(cgu_clks[no].off, busy);
 		cgu &= ~(1 << ce);
 		cpm_outl(cgu, cgu_clks[no].off);
 		cgu_clks[no].cache = 0;
@@ -458,11 +476,7 @@
 	cpm_outl(ddr_cgu,CPM_DDRCDR);
 	fail = 0;
 	TCSM_PCHAR('3');
-	while(cpm_inl(CPM_DDRCDR) & 1 << 28) {
-		serial_put_hex(cpm_inl(CPM_DDRCDR));
-		TCSM_PCHAR('\r');
-		TCSM_PCHAR('\n');
-	}
+	cgu_wait_busy(CPM_DDRCDR, 28);
 	TCSM_PCHAR('4');
 	cpm_clear_bit(25,CPM_DDRCDR);
 	REG32(0xb3012068) = 0xf0000100;
@@ -490,9 +504,10 @@
 {
 	int no;
 	int id;
+	if(t23zn_absent_cgu(CLK_CGU_NO(clk->flags)))
+		return; /* T23ZN-DEFENSE */
 	//printk("REG32(0xb3012088) = %x\n",REG32(0xb3012088));
 
-
 	if (clk->flags & CLK_FLG_PARENT) {
 		id = CLK_PARENT(clk->flags);
 		clk->parent = get_clk_from_id(id);
@@ -500,8 +515,11 @@
