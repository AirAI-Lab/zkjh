 	}
 	no = CLK_CGU_NO(clk->flags);
+
 	cgu_clks[no].cache = 0;
+
 	clk->rate = cgu_get_rate(clk);
+
 	if(cgu_is_enabled(clk)) {
 		clk->flags |= CLK_FLG_ENABLE;
 	}
